# Copie para .env.local (fora do git) e ajuste.
# Servidor de teste acessado por SSH (usuário@endereço).
LAB0_HOST=usuario@servidor.local
# Pasta do acervo no servidor de teste.
LAB0_DADOS=/srv/offline/LabOffline
# Pasta do clone de teste na home do usuário e porta da instância de teste.
LAB0_REPO=offline-library-teste
LAB0_PORTA=9087
